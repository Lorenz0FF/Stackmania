# EditorConfig for Stackmania
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = space
indent_size = 4
continuation_indent_size = 8
max_line_length = 120

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
# Markdown sometimes needs trailing spaces (two-space line break)
trim_trailing_whitespace = false

[*.{gradle,gradle.kts}]
indent_style = space
indent_size = 4

[*.{json,jsonc}]
indent_style = space
indent_size = 2

[*.{xml,html}]
indent_style = space
indent_size = 2

[*.properties]
indent_style = space
indent_size = 4

[*.sh]
indent_style = space
indent_size = 2
end_of_line = lf

[*.{bat,cmd,ps1}]
end_of_line = crlf

[Makefile]
indent_style = tab

# Minimal Stackmania server.properties for the plugin-compat container.
# Tuned for: fast boot, low memory, no network exposure, no real player traffic.
# DO NOT use this for a production server — values are intentionally degenerate.
allow-flight=true
allow-nether=false
broadcast-console-to-ops=true
broadcast-rcon-to-ops=true
difficulty=peaceful
enable-command-block=false
enable-jmx-monitoring=false
enable-query=false
enable-rcon=false
enable-status=false
enforce-secure-profile=false
enforce-whitelist=true
entity-broadcast-range-percentage=50
force-gamemode=true
function-permission-level=2
gamemode=creative
generate-structures=false
generator-settings={}
hardcore=false
hide-online-players=true
initial-disabled-packs=
initial-enabled-packs=vanilla
level-name=compat-world
level-seed=stackmania-compat
level-type=minecraft\:flat
max-chained-neighbor-updates=1000000
max-players=1
max-tick-time=60000
max-world-size=1024
motd=Stackmania Plugin Compat Container
network-compression-threshold=256
online-mode=false
op-permission-level=4
player-idle-timeout=0
prevent-proxy-connections=false
pvp=false
query.port=25565
rate-limit=0
rcon.password=
rcon.port=25575
require-resource-pack=false
resource-pack=
resource-pack-prompt=
resource-pack-sha1=
server-ip=127.0.0.1
server-port=25565
simulation-distance=4
snooper-enabled=false
spawn-animals=false
spawn-monsters=false
spawn-npcs=false
spawn-protection=0
sync-chunk-writes=false
text-filtering-config=
use-native-transport=true
view-distance=4
white-list=true

# Example bench.env for a Pterodactyl-managed Stackmania server.
#
# Copy this file to `bench.env` (next to run_bench_matrix.sh) and edit the
# values to match your panel.
#
# The Pterodactyl client API key needs the "control" and "console" scopes on
# the target server. Generate one from your panel under
# Account Settings > API Credentials.

SERVER_TYPE=pterodactyl

# Base URL of your panel's client API. NO trailing slash.
# Typically: https://<your-panel>/api/client
PTERODACTYL_API_URL=https://panel.example.com/api/client

# Client API token, prefixed with "ptlc_".
PTERODACTYL_API_KEY=ptlc_replace_me

# Short server identifier (visible in the panel URL after /server/).
PTERODACTYL_SERVER_ID=abcd1234

# Absolute path on the bench host to the live stackmania.yml the panel mounts.
# If your panel runs on a different host, you must either run this script
# from there or expose the config dir via SFTP/NFS first.
STACKMANIA_CONFIG_PATH=/srv/pterodactyl/volumes/abcd1234/stackmania-config/stackmania.yml

# Absolute path to plugins/Stackmania/ — where bench dump JSON files land.
BENCH_DUMP_DIR=/srv/pterodactyl/volumes/abcd1234/plugins/Stackmania

# Where archived dumps + the final BENCHMARKS_results.md will be written.
OUTPUT_DIR=./bench-results

# Soak time per cycle. 30 min is the documented minimum to let GC/JIT settle.
# Bump to 45-60 if your hardware is under heavy churn or if the first cycle
# shows wildly inconsistent TPS.
SOAK_MINUTES=30
